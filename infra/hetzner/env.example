# infra/hetzner/.env (git-ignored): the server's settings and the platform's credentials, read by the Makefile.
# The publishers' credentials stay in the repository's .env (.env.example).

# The server's name on the tailnet
TS_HOST=power-desk
# bootstrap.sh: a pre-approved auth key tagged tag:power-desk (Tailscale admin console > Settings > Keys)
TAILSCALE_AUTHKEY=

# The edge firewall: the Robot webservice user (Robot > Settings > Webservice) and the server's number
ROBOT_USER=
ROBOT_PASSWORD=
SERVER_ID=
# Your address, to admit SSH at the edge while the tailnet is unreachable (empty: none)
BREAK_GLASS_IP=

# The Tailscale Kubernetes operator: an OAuth client with write scopes Devices Core, Auth Keys and Services,
# tagged tag:k8s-operator
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

GRAFANA_ADMIN_PASSWORD=
# Set before the first `make platform`: MySQL keeps the passwords it was created with
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# After `make platform`: OpenMetadata > Settings > Bots > ingestion-bot (the catalogue's ingestion)
OM_BOT_TOKEN=

# Only for ENTSO-E's pushes (`make public`): the public name (a DNS A record to the server) and a Cloudflare API
# token that may edit that zone's DNS (cert-manager's DNS-01 challenge)
PUBLIC_HOST=
CLOUDFLARE_API_TOKEN=
