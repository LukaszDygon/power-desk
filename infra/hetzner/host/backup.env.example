# /etc/power-desk/backup.env (root, 0600): where backup.sh sends the nightly snapshot. Then, on the server:
#   openssl rand -base64 32 > /etc/power-desk/restic-password && chmod 0600 /etc/power-desk/restic-password
#   systemctl enable --now power-desk-backup.timer
# Keep a copy of the restic password off the server: without it the backups cannot be read.

# A Storage Box in another location than the server (e.g. server in FSN1, box in HEL1), over SFTP on port 23.
# Enable SSH and "External reachability" for the box, add root's key (ssh-keygen -t ed25519 -f /root/.ssh/storagebox)
# to its authorized keys, and give it a host entry in /root/.ssh/config:
#   Host storagebox
#     HostName uXXXXXX.your-storagebox.de
#     User uXXXXXX
#     Port 23
#     IdentityFile /root/.ssh/storagebox
RESTIC_REPOSITORY=sftp:storagebox:power-desk
# Or Object Storage (S3), with AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY exported here:
#   RESTIC_REPOSITORY=s3:https://hel1.your-objectstorage.com/<bucket>/restic

RESTIC_PASSWORD_FILE=/etc/power-desk/restic-password

# room for the blocks written while the backup runs (vg0's free space; bootstrap.sh leaves 20 %)
SNAPSHOT_SIZE=50G

KEEP_DAILY=7
KEEP_WEEKLY=5
KEEP_MONTHLY=12
