{
  "uid": "power-desk-logs",
  "title": "Power Desk logs",
  "description": "Logs in the Power Desk log standard (docs/logging.md): services, Dagster runs and the platform",
  "tags": ["power-desk", "logs"],
  "schemaVersion": 39,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service", "label": "Service", "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": {"type": 1, "label": "service_name", "stream": "", "refId": "service"},
        "multi": true, "includeAll": true, "allValue": ".+", "current": {"text": "All", "value": "$__all"}, "refresh": 2
      },
      {
        "name": "level", "label": "Level", "type": "custom",
        "query": "CRITICAL,ERROR,WARNING,INFO,DEBUG",
        "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}
      },
      {"name": "run", "label": "Dagster run id", "type": "textbox", "query": ""},
      {"name": "load", "label": "dlt load id", "type": "textbox", "query": ""},
      {"name": "search", "label": "Text", "type": "textbox", "query": ""}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Records by level",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 6},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal"}}}, "overrides": []},
      "targets": [{
        "refId": "A", "legendFormat": "{{level}}",
        "expr": "sum by (level) (count_over_time({service_name=~\"$service\", level=~\"$level\"} | dagster_run_id=~\"$run.*\" | dlt_load_id=~\"$load.*\" |= \"$search\" [$__auto]))"
      }]
    },
    {
      "id": 2, "type": "logs", "title": "dlt loads",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 9},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{event_name=\"dlt.load\", service_name=~\"$service\"} | dagster_run_id=~\"$run.*\" | dlt_load_id=~\"$load.*\""}]
    },
    {
      "id": 3, "type": "logs", "title": "Errors",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 9},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{service_name=~\"$service\", level=~\"ERROR|CRITICAL\"} | dagster_run_id=~\"$run.*\" | dlt_load_id=~\"$load.*\""}]
    },
    {
      "id": 4, "type": "logs", "title": "Records",
      "gridPos": {"x": 0, "y": 15, "w": 24, "h": 16},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {"showTime": true, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{service_name=~\"$service\", level=~\"$level\"} | dagster_run_id=~\"$run.*\" | dlt_load_id=~\"$load.*\" |= \"$search\""}]
    }
  ]
}
